# Copy this file to .env for local testing, or set these as env vars on Northflank.
DISCORD_TOKEN=your-bot-token-here
# Main brain: free key from https://aistudio.google.com
GEMINI_API_KEY=your-gemini-key-here
# Optional fallback, used only if GEMINI_API_KEY is empty: key from https://console.groq.com
# GROQ_API_KEY=gsk-your-groq-key-here
# Optional: Tavily key from https://tavily.com (free tier, no card). Without it,
# web search uses Tavily's free keyless mode, so it works out of the box.
# SEARCH_API_KEY=tvly-your-key-here
# Optional overrides:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# BOT_NAME=Kristy
# SEARCH_PROVIDER=tavily
# SEARCH_MAX_PER_DAY=25
