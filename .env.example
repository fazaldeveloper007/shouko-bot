# Copy this file to .env for local testing, or set these as env vars on Northflank.
DISCORD_TOKEN=your-bot-token-here
# Main brain: free key from https://aistudio.google.com
GEMINI_API_KEY=your-gemini-key-here
# Optional fallback, used only if GEMINI_API_KEY is empty: key from https://console.groq.com
# GROQ_API_KEY=gsk-your-groq-key-here
# Optional: Tavily key from https://tavily.com (free tier, no card). Without it,
# web search uses Tavily's free keyless mode, so it works out of the box.
# SEARCH_API_KEY=tvly-your-key-here
# Optional overrides:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# BOT_NAME=Kristy
# OWNER_ID=your-discord-user-id
# SEARCH_PROVIDER=tavily
# SEARCH_MAX_PER_DAY=25
# SEARCH_MAX_PER_DAY=25

# Proactive announcements (morning post, redeem codes, events, welcomes).
# All optional - defaults below are set for Fazal's server.
# NOTE: the bot role needs "Mention @everyone" permission in both channels,
# and "Server Members Intent" ON in the developer portal for welcomes.
# ANNOUNCE_ENABLED=1            master switch for everything below
# ANNOUNCE_DRY_RUN=0            1 = log what would be posted, send nothing
# MORNING_CHANNEL_ID=1438772091116847246
# MORNING_TIME=09:00            local time in MORNING_TZ; offline at that time = skipped that day
# MORNING_TZ=Asia/Kolkata
# CODES_CHANNEL_ID=1438772091116847247
# EVENTS_CHANNEL_ID=1438772091116847247
# WELCOME_CHANNEL_ID=1438772091116847246
# WELCOME_ENABLED=1
# ANNOUNCE_CODES_MODE=community off | strict | community
# ANNOUNCE_CHECK_MINUTES=60     codes/events poll cadence
# OFFICIAL_UIDS=1015537         HoYoLAB uids treated as official

# Music is OFF until separately approved setup/deployment.
MUSIC_ENABLED=0
# Explicit opt-in to register global slash commands on startup (requires approval).
MUSIC_SYNC_COMMANDS=0

# Optional approved test-server-only registration. Blank means global when sync enabled.
MUSIC_TEST_GUILD_ID=
# Optional: custom monochrome player-button icons (application emoji name:id), set by the icon setup helper
# MUSIC_ICON_PLAY=
# MUSIC_ICON_PAUSE=
# MUSIC_ICON_SKIP=
# MUSIC_ICON_QUEUE=
# MUSIC_ICON_STOP=
# MUSIC_ICON_LEAVE=
